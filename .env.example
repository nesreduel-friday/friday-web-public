# Friday — Konfiguration. Nach .env kopieren und ausfüllen.

# Gemini-Schlüssel aus Google AI Studio. Im EWR gelten auch für die
# kostenlose Stufe die Datenbedingungen der bezahlten: kein Training
# mit deinen Eingaben (Gemini API Terms, Stand 28.04.2026).
# Gebraucht ab Phase 1.
GEMINI_API_KEY=

# Sprachmodell. Nicht raten — `native-audio-preview-12-2025` bricht
# mitten im Gespräch ab. Siehe docs/STRUKTUR.md, Abschnitt Betrieb.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Textmodell(e) für den Chat, kommagetrennt, das erste zuerst. Leer lassen:
# dann gilt die gemessene Reihenfolge aus kern/config.py.
GEMINI_TEXTMODELL=

FRIDAY_STIMME=Callirrhoe

# Optional: eigener Gemini-Schlüssel nur für das Langzeitgedächtnis (Graphiti).
# Bringt nur etwas, wenn er aus einem ANDEREN Google-Projekt stammt — die
# Limits gelten pro Projekt, nicht pro Schlüssel. Leer = GEMINI_API_KEY.
# Goodnotes-Hefte abschreiben (eigenes Projekt). Leer = Hausaufgaben-Schlüssel.
GOODNOTES_GEMINI_API_KEY=
# Reserve für Hausaufgaben (Lösen, Bücher, Goodnotes), eigenes Projekt. Leer = Hintergrund-Schlüssel.
HAUSAUFGABEN_GEMINI_API_KEY=
# Schulbücher einscannen/indexieren (eigenes Projekt, getrennt vom Lösen: damit
# beide sich nicht das Tageskontingent streitig machen). Leer = Hausaufgaben-Schlüssel.
BUECHER_GEMINI_API_KEY=
# Hausaufgaben lösen (eigenes Projekt, getrennt vom Einlesen: damit beide sich
# nicht das Tageskontingent streitig machen). Leer = Hausaufgaben-Schlüssel.
LOESEN_GEMINI_API_KEY=
# Reserve fürs Lösen (eigenes Projekt, für Tage, an denen das Kontingent des
# ersten reicht). Leer = Hausaufgaben-Schlüssel.
LOESEN_RESERVE_GEMINI_API_KEY=
# Klassenarbeiten lesen (Schule → Arbeiten; eigenes Projekt, damit sich niemand das
# Tageskontingent streitig macht). Leer = Hausaufgaben-Schlüssel.
ARBEITEN_GEMINI_API_KEY=
GRAPHITI_GEMINI_API_KEY=

# Wohnort fürs Wetter (Werkzeug und Morgenbriefing). Mehrdeutige Namen mit
# Gemeinde angeben: „Holtensen, Musterhausen“ — in Niedersachsen gibt es fünf.
# Leer = Hannover.
FRIDAY_ORT=
# Deine Adresse, damit Friday bei „Wo bin ich?“ auch „zu Hause“ sagen kann (Standort). Sie wird einmal
# bei OpenStreetMap nachgeschlagen und nur im Arbeitsspeicher gehalten. Leer = Friday kennt nur den Ort.
FRIDAY_HEIMADRESSE=

# Voreinstellung für die Uhrzeit des Morgenbriefings, HH:MM. Leer = 06:30.
# Was in den Einstellungen der App gesetzt ist, geht vor.
BRIEFING_UHRZEIT=

# WhatsApp (Konnektor whatsapp, Container waha): Schlüssel, mit dem Friday sich beim
# WAHA-Container anmeldet. Frei wählbar, aber setzen — sonst käme jeder im Docker-Netz
# an die Chats. Leer lassen heißt: kein Schutz.
WAHA_SCHLUESSEL=

# Soll Friday stündlich von selbst in den freigegebenen Chats nachsehen (fürs Morgenbriefing
# und damit Antworten sofort kommen)? „aus“ heißt: nur lesen, wenn du fragst.
WHATSAPP_HINTERGRUND=an

# ---------- PC (Windows) ----------
# Wo der Friday-Helfer auf dem PC zu erreichen ist (Tailnet-Adresse des PCs, Port 8765) —
# Vorgabe für „Einrichten“ auf der Freigaben-Seite.
PC_ADRESSE=
# Die Tailnet-Adresse von hphome: Nur von dort nimmt der Helfer Aufträge an (Firewall und Helfer).
PC_FRIDAY_IP=

# Lokaler Embedder für den Wissensgraphen (05.10.2026). Standard: Gemini. Erst nach dem Neu-Einbetten umschalten
# (docs/superpowers/plans/2026-10-04-lokaler-embedder.md): EMBEDDER_PROVIDER_GRAPHITI=openai,
# EMBEDDER_MODEL=intfloat/multilingual-e5-small, EMBEDDER_DIMS=384
EMBEDDER_PROVIDER_GRAPHITI=
EMBEDDER_MODEL=
EMBEDDER_DIMS=
